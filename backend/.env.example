# HI IN Property Directory — Environment Configuration
# Project: Phase 2 Real Location Intelligence

# Security
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default for zero-dependency local run; can be PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./hi_in.db
# Example for PostgreSQL: postgresql://postgres:postgres@localhost:5432/hi_in

# Development & Seed Mode
DEMO_MODE=true

# External Services Configuration
# OpenStreetMap Nominatim Geocoding
NOMINATIM_USER_AGENT=HI-IN-Property-Directory/2.0 (contact: research@hi-in.demo)

# OSRM Routing Engine (Defaults to public project-osrm endpoint or local instance)
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving

# Open-Meteo Air Quality API
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Overpass API Mirrors (comma-separated if custom)
OVERPASS_PRIMARY_URL=https://overpass-api.de/api/interpreter
